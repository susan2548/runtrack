{
  "expo": {
    "name": "RunTrackerApp",
    "slug": "RunTrackerApp",
    "version": "1.1.1",
    "scheme": "runtracker",
    "orientation": "portrait",
    "icon": "./assets/runtracker-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#070A09",
        "foregroundImage": "./assets/runtracker-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.runtrackerapp"
    },
    "web": {
      "favicon": "./assets/runtracker-icon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RunTracker ใช้ตำแหน่ง GPS ของคุณเพื่อบันทึกเส้นทางการวิ่ง/ปั่นจักรยาน แม้ขณะแอปทำงานอยู่เบื้องหลัง",
          "locationWhenInUsePermission": "RunTracker ใช้ตำแหน่ง GPS ของคุณเพื่อคำนวณระยะทางและความเร็วระหว่างการวิ่ง/ปั่นจักรยาน",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "RunTracker ใช้รูปที่คุณเลือกเพื่อแสดงเป็นรูปโปรไฟล์",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
