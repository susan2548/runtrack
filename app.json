{
  "expo": {
    "name": "RunTrackerApp",
    "slug": "RunTrackerApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.runtrackerapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RunTracker ใช้ตำแหน่ง GPS ของคุณเพื่อบันทึกเส้นทางการวิ่ง/ปั่นจักรยาน แม้ขณะแอปทำงานอยู่เบื้องหลัง",
          "locationWhenInUsePermission": "RunTracker ใช้ตำแหน่ง GPS ของคุณเพื่อคำนวณระยะทางและความเร็วระหว่างการวิ่ง/ปั่นจักรยาน",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font"
    ]
  }
}
